# Supabase project settings
# Copy this file to .env.local and replace the placeholders with values from
# the Supabase project Connect dialog. The publishable key is safe for browser
# use when Row Level Security is enabled; never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only OpenAI configuration. Never expose this key with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-openai-project-key
OPENAI_MODEL=gpt-6-luna
# Set these from the provider's current pricing for the configured model.
# If omitted, tokens are still metered and estimated cost remains $0.
OPENAI_INPUT_COST_PER_1M_USD=0
OPENAI_OUTPUT_COST_PER_1M_USD=0

# Server-only automation configuration. Generate long random values in production.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=replace-with-a-long-random-secret

# Meta WhatsApp Cloud API (server-only). Each agency integration stores only
# the environment variable name that points to its own access token.
META_WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-secret
META_APP_SECRET=your-meta-app-secret
META_GRAPH_VERSION=v23.0
META_WHATSAPP_TOKEN_AGENCY_SLUG=your-permanent-system-user-token

# Embedded Signup. App ID and configuration ID are safe browser identifiers;
# App Secret and encryption key must remain server-only.
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_WHATSAPP_CONFIG_ID=your-embedded-signup-configuration-id
NEXT_PUBLIC_META_GRAPH_VERSION=v23.0
INTEGRATION_ENCRYPTION_KEY=base64-encoded-32-byte-random-key
NEXT_PUBLIC_SITE_URL=https://your-public-domain.example
